# backend/.env.example

# ============================================
# Core Application
# ============================================

APP_NAME=Smart Railway Platform

DATABASE_URL=
SECRET_KEY=

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false


# ============================================
# MongoDB Atlas
# ============================================

MONGODB_URI=
MONGODB_DATABASE=railway_inspection


# ============================================
# Colab AI Service
# ============================================

COLAB_API_URL=

ENABLE_AI_AGENT=true
ENABLE_CHATBOT=true

CHATBOT_RATE_LIMIT=10
AGENT_MAX_HISTORY=10
